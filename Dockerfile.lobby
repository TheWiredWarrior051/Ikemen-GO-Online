# Lightweight multi-stage Dockerfile for deploying the Ikemen GO Lobby Server to Render (Free Tier)
FROM golang:1.24-alpine AS builder
WORKDIR /app

COPY go.mod go.sum ./
# Allow newer go directive in go.mod via GOTOOLCHAIN=auto
ENV GOTOOLCHAIN=auto
RUN go mod download github.com/gorilla/websocket

COPY cmd/lobby-server ./cmd/lobby-server
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /lobby-server ./cmd/lobby-server

FROM alpine:3.20
RUN apk --no-cache add ca-certificates
COPY --from=builder /lobby-server /usr/local/bin/lobby-server
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/lobby-server"]
